{
  "openapi": "3.1.0",
  "info": {
    "title": "Bounty Engineer Merchant Feed QA",
    "version": "1.0.0",
    "description": "Buyer-paid Google Merchant RSS/XML or JSON feed validation for up to 1,000 products, including identifiers, prices, availability and variant warnings."
  },
  "servers": [
    {
      "url": "https://bounty-engineer-x402-prod.onrender.com"
    }
  ],
  "paths": {
    "/v1/merchant-feed-audit": {
      "post": {
        "operationId": "bountyMerchantFeedAudit",
        "summary": "Audit up to 1,000 Merchant Center RSS/XML or JSON products",
        "description": "Check uploaded Google Merchant product data for duplicate IDs, GTIN checksum errors, required attributes, price syntax, availability, and variant issues. This is a deterministic diagnostic report, not Google Merchant Center certification. No third-party URL is fetched.",
        "tags": [
          "ecommerce",
          "merchant-feed",
          "gtin",
          "product-data"
        ],
        "x-payment-info": {
          "amount": 4.9,
          "currency": "USDC",
          "network": "eip155:8453",
          "additionalNetworks": [
            "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"
          ],
          "protocols": [
            {
              "x402": {}
            }
          ]
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "feed_xml": {
                    "type": "string",
                    "maxLength": 800000
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1000,
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "feed_xml"
                    ]
                  },
                  {
                    "required": [
                      "items"
                    ]
                  }
                ]
              },
              "example": {
                "items": [
                  {
                    "id": "sample-42",
                    "title": "Example shoe",
                    "description": "Sample product",
                    "link": "https://example.com/p",
                    "image_link": "https://example.com/p.jpg",
                    "availability": "in_stock",
                    "price": "49.90 EUR",
                    "brand": "Example"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid deterministic feed diagnostic with issue counts, fields and SHA-256 evidence"
          },
          "400": {
            "description": "Invalid input; preflight rejects before paid audit"
          },
          "402": {
            "description": "x402 payment required; USDC on supported Base or Solana networks"
          },
          "503": {
            "description": "Service temporarily unavailable"
          }
        }
      }
    }
  }
}
